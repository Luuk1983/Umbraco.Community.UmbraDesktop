<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The global XML-doc rule applies to tests too, as it does in the host's test project. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- The add-on alone, as the Accessories tests take theirs: it brings Umbraco through the host. -->
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Media\Umbraco.Community.UmbraDesktop.Media.csproj" />
  </ItemGroup>

</Project>
