<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extension package dependencies -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="17.3.0" />
    <!-- The Entertainment add-on's dependency on the host package. A range, not the exact version
         it is built beside, so a host release does not force an Entertainment release (design D13).
         Central package management means the version lives here rather than in that csproj. -->
    <PackageVersion Include="Umbraco.Community.UmbraDesktop" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.JsonSchema.Extensions" Version="0.*" />
    <!-- Build-time only: versioning and source-link -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <!-- Test instance dependencies -->
    <PackageVersion Include="Umbraco.Cms" Version="17.*" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="17.0.0" />
    <PackageVersion Include="uSync" Version="17.*" />
    <!-- Umbraco's commercial packages, present so the catalogue's commercial entries can actually
         be exercised locally. Unlicensed they run in trial mode, which is enough to register their
         backoffice extensions — which is all the catalogue resolves against. Deploy is the on-prem
         build, since the Cloud one is not installable here. -->
    <PackageVersion Include="Umbraco.Forms" Version="17.*" />
    <PackageVersion Include="Umbraco.Deploy.OnPrem" Version="17.*" />
    <PackageVersion Include="Umbraco.Workflow" Version="17.*" />
    <PackageVersion Include="Umbraco.Commerce" Version="17.*" />
    <PackageVersion Include="Umbraco.Engage" Version="17.*" />
    <PackageVersion Include="Umbraco.UIBuilder" Version="17.*" />
    <PackageVersion Include="Umbraco.Automate" Version="17.*" />
    <PackageVersion Include="Umbraco.AI" Version="17.*" />
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>
</Project>