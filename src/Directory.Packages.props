<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extension package dependencies -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="17.3.0" />
    <!-- The Entertainment add-on's dependency on the host package. A range, not the exact version
         it is built beside, so a host release does not force an Entertainment release (design D13).
         Central package management means the version lives here rather than in that csproj. -->
    <PackageVersion Include="Umbraco.Community.UmbraDesktop" Version="[17.0.0,18.0.0)" />
    <PackageVersion Include="Umbraco.JsonSchema.Extensions" Version="0.*" />
    <!-- Build-time only: versioning and source-link -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <!-- Test instance dependencies -->
    <PackageVersion Include="Umbraco.Cms" Version="17.*" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="17.0.0" />
    <PackageVersion Include="uSync" Version="17.*" />
    <!-- Umbraco's commercial packages, present so the catalogue's commercial entries can actually
         be exercised locally. Unlicensed they run in trial mode, which is enough to register their
         backoffice extensions — which is all the catalogue resolves against. Deploy is the on-prem
         build, since the Cloud one is not installable here. -->
    <PackageVersion Include="Umbraco.Forms" Version="17.*" />
    <PackageVersion Include="Umbraco.Deploy.OnPrem" Version="17.*" />
    <PackageVersion Include="Umbraco.Workflow" Version="17.*" />
    <PackageVersion Include="Umbraco.Commerce" Version="17.*" />
    <PackageVersion Include="Umbraco.Engage" Version="17.*" />
    <PackageVersion Include="Umbraco.UIBuilder" Version="17.*" />
    <PackageVersion Include="Umbraco.Automate" Version="17.*" />
    <!-- Umbraco AI, pinned rather than floating, and in three parts. The desktop's AI integration
         (backoffice/src/desktop/ai/) needs the Copilot Workspace, which is new in AI 17.4, and
         `17.*` resolves to 17.3.1 because a floating range will not take a prerelease. The add-ons
         version independently of AI core, so these numbers do not match each other and are not
         meant to: both Agent and Copilot.Workspace declare `Umbraco.AI.Startup [17.4.0-rc.2,
         17.999.999)`, which is what makes this exact set coherent.
         Agent and Agent.UI are here because Copilot.Workspace depends on neither in NuGet and yet
         its client imports from both at runtime. Each AI package contributes one backoffice
         import-map entry, and the workspace's client imports three of them: `@umbraco-ai/core`
         (Umbraco.AI), `@umbraco-ai/agent` (Agent) and `@umbraco-ai/agent-ui` (Agent.UI). Miss any
         one and the section's module fails to resolve, so the chat never renders and the console
         says `Failed to resolve module specifier`. It does *not* import `@umbraco-ai/agent-copilot`,
         so the sidebar Copilot package is genuinely not needed.
         Test-instance only, like the seven commercial packages above: the shipped package
         references no AI package and must never depend on one. -->
    <PackageVersion Include="Umbraco.AI" Version="17.4.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="17.2.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent.UI" Version="17.1.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot.Workspace" Version="17.0.0-rc.2" />
    <!-- A model provider, so the chat in the test instance can actually answer. Any one would do;
         Anthropic is simply the key we have. Stable rather than an RC because it depends only on
         `Umbraco.AI.Core [17.3.0, 17.999.999)`, which 17.4.0-rc.2 satisfies. Needs an API key in
         user secrets or the AI section to do anything. -->
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="17.1.0" />
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>
</Project>