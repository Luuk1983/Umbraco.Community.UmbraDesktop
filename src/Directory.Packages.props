<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- The oldest Umbraco each major's packages install on (plan D4). 17.6.0 for 17, not 17.0.0: the
         bundles import names the backoffice only exports from 17.4 (clearImagingCache, the UMB_THEME_*
         aliases, Lit's keyed and live, and more), so on 17.0 to 17.3 the desktop never loaded; and the
         overwrite guard needs the workspace's loadWithoutPersist, which core added in 17.6. 18.0.0
         for 18, which has them all. The build action's floor check
         (backoffice/scripts/check-umbraco-floor.mjs) holds every packed bundle to its major's floor. -->
    <UmbraDesktopUmbracoFloor Condition="'$(UmbracoMajor)' == '17'">17.6.0</UmbraDesktopUmbracoFloor>
    <UmbraDesktopUmbracoFloor Condition="'$(UmbracoMajor)' == '18'">18.0.0</UmbraDesktopUmbracoFloor>
    <!-- EF Core for the Arcade's design-time tools and the tests' SQLite: what that major's
         Umbraco.Cms.Persistence.EFCore at the floor requires (10.0.10 for 17.6.0, 10.0.7 for 18.0.0).
         Lower, and restore fails on a downgrade (NU1605); raise it with the floor. -->
    <UmbraDesktopEFCoreVersion Condition="'$(UmbracoMajor)' == '17'">10.0.10</UmbraDesktopEFCoreVersion>
    <UmbraDesktopEFCoreVersion Condition="'$(UmbracoMajor)' == '18'">10.0.7</UmbraDesktopEFCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extension package dependencies. The ceiling is UmbraDesktopUmbracoMajorCeiling from
         Directory.Build.props, <major>.99999999, rather than the next major exclusive: NuGet orders
         18.0.0-rc.1 before 18.0.0, so "[17.6.0,18.0.0)" admits every Umbraco 18 prerelease, and the
         next major's betas are exactly what this package has never been tested against. The same
         property bounds every add-on's dependency on the host, so the two cannot drift apart. -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.Cms.StaticAssets" Version="[$(UmbraDesktopUmbracoFloor),$(UmbraDesktopUmbracoMajorCeiling)]" />
    <PackageVersion Include="Umbraco.JsonSchema.Extensions" Version="0.*" />
    <!-- Build-time only: versioning and source-link -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(UmbraDesktopEFCoreVersion)" />
  </ItemGroup>
  <!-- Test instance dependencies, one set per Umbraco major: each test instance (.TestInstance for 17,
       .TestInstance.v18 for 18) builds with its own major, so it only ever sees its own set. -->
  <ItemGroup Condition="'$(UmbracoMajor)' == '17'">
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="17.3.0" />
    <PackageVersion Include="Umbraco.Cms" Version="17.*" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="17.0.0" />
    <PackageVersion Include="uSync" Version="17.*" />
    <!-- Umbraco's commercial packages, present so the catalogue's commercial entries can actually
         be exercised locally. Unlicensed they run in trial mode, which is enough to register their
         backoffice extensions — which is all the catalogue resolves against. Deploy is the on-prem
         build, since the Cloud one is not installable here. -->
    <PackageVersion Include="Umbraco.Forms" Version="17.*" />
    <PackageVersion Include="Umbraco.Deploy.OnPrem" Version="17.*" />
    <PackageVersion Include="Umbraco.Workflow" Version="17.*" />
    <PackageVersion Include="Umbraco.Commerce" Version="17.*" />
    <PackageVersion Include="Umbraco.Engage" Version="17.*" />
    <PackageVersion Include="Umbraco.UIBuilder" Version="17.*" />
    <PackageVersion Include="Umbraco.Automate" Version="17.*" />
    <!-- Umbraco AI, pinned rather than floating, and in three parts. The desktop's AI integration
         (backoffice/src/desktop/ai/) needs the Copilot Workspace, which is new in AI 17.4, and
         `17.*` resolves to 17.3.1 because a floating range will not take a prerelease. The add-ons
         version independently of AI core, so these numbers do not match each other and are not
         meant to: both Agent and Copilot.Workspace declare `Umbraco.AI.Startup [17.4.0-rc.2,
         17.999.999)`, which is what makes this exact set coherent.
         Agent and Agent.UI are here because Copilot.Workspace depends on neither in NuGet and yet
         its client imports from both at runtime. Each AI package contributes one backoffice
         import-map entry, and the workspace's client imports three of them: `@umbraco-ai/core`
         (Umbraco.AI), `@umbraco-ai/agent` (Agent) and `@umbraco-ai/agent-ui` (Agent.UI). Miss any
         one and the section's module fails to resolve, so the chat never renders and the console
         says `Failed to resolve module specifier`. It does *not* import `@umbraco-ai/agent-copilot`,
         so the sidebar Copilot package is genuinely not needed.
         Test-instance only, like the seven commercial packages above: the shipped package
         references no AI package and must never depend on one. -->
    <PackageVersion Include="Umbraco.AI" Version="17.4.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="17.2.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent.UI" Version="17.1.0-rc.2" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot.Workspace" Version="17.0.0-rc.2" />
    <!-- A model provider, so the chat in the test instance can actually answer. Any one would do;
         Anthropic is simply the key we have. Stable rather than an RC because it depends only on
         `Umbraco.AI.Core [17.3.0, 17.999.999)`, which 17.4.0-rc.2 satisfies. Needs an API key in
         user secrets or the AI section to do anything. -->
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="17.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmbracoMajor)' == '18'">
    <PackageVersion Include="Umbraco.Cms" Version="18.*" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="18.0.0" />
    <PackageVersion Include="uSync" Version="18.*" />
    <PackageVersion Include="Umbraco.Community.AdvancedPermissions" Version="18.2.0" />
    <PackageVersion Include="Umbraco.Forms" Version="18.*" />
    <PackageVersion Include="Umbraco.Deploy.OnPrem" Version="18.*" />
    <PackageVersion Include="Umbraco.Workflow" Version="18.*" />
    <PackageVersion Include="Umbraco.Commerce" Version="18.*" />
    <PackageVersion Include="Umbraco.Engage" Version="18.*" />
    <PackageVersion Include="Umbraco.UIBuilder" Version="18.*" />
    <PackageVersion Include="Umbraco.Automate" Version="18.*" />
    <!-- Every Umbraco AI package has a stable 18 release, so 18 needs none of 17's pinned RCs. Still
         pinned rather than floating, for the same reason as 17: the add-ons version independently of
         AI core and only a matching set resolves. Spike: newest stable of each on 2026-10-23. -->
    <PackageVersion Include="Umbraco.AI" Version="18.6.0" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="18.4.0" />
    <PackageVersion Include="Umbraco.AI.Agent.UI" Version="18.3.0" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot.Workspace" Version="18.2.0" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="18.1.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(UmbraDesktopEFCoreVersion)" />
  </ItemGroup>
</Project>