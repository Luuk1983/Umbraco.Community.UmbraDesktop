<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <PackageReference Include="Umbraco.Community.AdvancedPermissions" />
    <PackageReference Include="Umbraco.TheStarterKit" />
    <PackageReference Include="uSync" />
  </ItemGroup>

  <!-- Umbraco's commercial packages and Umbraco AI. Every one is here so the catalogue's commercial
       entries resolve against the real registered extensions rather than being taken on trust.
       Back on since Umbraco 19.0.0-rc1: they were switched off for beta1, which none of them
       supported, and every one shipped a 19 release candidate by 2026-11-19. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Forms" />
    <PackageReference Include="Umbraco.Deploy.OnPrem" />
    <PackageReference Include="Umbraco.Workflow" />
    <PackageReference Include="Umbraco.Commerce" />
    <!-- Engage is left out on 19.0.0-rc1. Its rc1, like Forms', is built against CsvHelper 33.1;
         Workflow's and UI Builder's rc1 pull in CsvHelper 34, which has no ClassMap<T> where 33 did.
         NuGet resolves 34, and the site fails at boot scanning Engage's types (TypeLoadException on
         CsvHelper.Configuration.ClassMap`1). Forms boots with it. Put Engage back when a release of
         the four agrees on CsvHelper. -->
    <!-- <PackageReference Include="Umbraco.Engage" /> -->
    <PackageReference Include="Umbraco.UIBuilder" />
    <PackageReference Include="Umbraco.Automate" />
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.AI.Agent" />
    <PackageReference Include="Umbraco.AI.Agent.UI" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot.Workspace" />
    <PackageReference Include="Umbraco.AI.Anthropic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop\Umbraco.Community.UmbraDesktop.csproj" />
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Entertainment\Umbraco.Community.UmbraDesktop.Entertainment.csproj" />
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Accessories\Umbraco.Community.UmbraDesktop.Accessories.csproj" />
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Media\Umbraco.Community.UmbraDesktop.Media.csproj" />
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Services.Arcade\Umbraco.Community.UmbraDesktop.Services.Arcade.csproj" />
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Services.Media\Umbraco.Community.UmbraDesktop.Services.Media.csproj" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>


</Project>
