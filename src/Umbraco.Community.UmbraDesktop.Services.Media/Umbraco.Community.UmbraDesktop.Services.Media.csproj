<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	  <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <ContentTargetFolders>.</ContentTargetFolders>
	  <Product>Umbraco.Community.UmbraDesktop.Services.Media</Product>
	  <PackageId>Umbraco.Community.UmbraDesktop.Services.Media</PackageId>
	  <Title>UmbraDesktop Media service</Title>
	  <Description>Opening and saving media library files for UmbraDesktop apps. A service package: you get it with an add-on that uses it, such as the UmbraDesktop Accessories Add-on or the UmbraDesktop Media Add-on, and do not need to install it yourself.</Description>
	  <PackageTags>umbraco;backoffice;desktop;umbradesktop;media</PackageTags>
	  <RootNamespace>Umbraco.Community.UmbraDesktop.Services.Media</RootNamespace>
	  <Authors>Luuk Peters</Authors>
	  <Company>Luuk Peters</Company>
	  <Copyright>Copyright (c) Luuk Peters</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/Luuk1983/Umbraco.Community.UmbraDesktop</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/Luuk1983/Umbraco.Community.UmbraDesktop</PackageProjectUrl>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <!-- The host's artwork, packed by path below, as the Arcade does: the packages ship as one release. -->
	  <PackageIcon>Package-image_128_128.png</PackageIcon>
	  <!-- Its own readme, as the Arcade's: the root README.md describes the desktop, not this service. -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

	  <!-- Symbols + SourceLink: consumers can debug into the source at the exact built commit -->
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
  </PropertyGroup>

	<!-- The built umbraco-package.json, which SyncUmbracoPackageVersion (src/Directory.Build.targets)
	     stamps with this package's version. Versioning is shared by all six packages, there. -->
	<PropertyGroup>
		<UmbracoPackageJsonPath>$(ProjectDir)wwwroot\App_Plugins\Umbraco.Community.UmbraDesktop.Services.Media\umbraco-package.json</UmbracoPackageJsonPath>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only files, kept out of the package root as in the other packages. -->
    <Content Remove="backoffice\**" />
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
    <!-- The docs reach the package through the Vite build, which copies them into wwwroot for Help. -->
    <Content Remove="docs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Umbraco.Community.UmbraDesktop\Package-image_128_128.png" Pack="true" PackagePath="\" />
    <!-- Update, not Include: the SDK's default None glob already matches this file. -->
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup>
	  <PackageReference Include="MinVer" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <!-- The host, built beside this one, for the reason the Arcade gives: this package relies on the
	       desktop context seam (umbraDesktopContext) and the Help app's umbraDesktopDocs, and a
	       package range would compile it against the lowest host in range. The packed range comes
	       from the BoundHostRange target in src/Directory.Build.targets. There is no C# here: the
	       project exists to package and serve the bundle. -->
	  <ProjectReference Include="..\Umbraco.Community.UmbraDesktop\Umbraco.Community.UmbraDesktop.csproj" />
	</ItemGroup>

</Project>
