<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	  <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <ContentTargetFolders>.</ContentTargetFolders>
	  <Product>Umbraco.Community.UmbraDesktop.Accessories</Product>
	  <PackageId>Umbraco.Community.UmbraDesktop.Accessories</PackageId>
	  <Title>UmbraDesktop Accessories Add-on</Title>
	  <Description>The small tools for UmbraDesktop. An optional add-on that puts Notepad, Paint, Sticky Notes, Calculator, Character Map, Clock, Screen Saver, Disk Cleanup and System Information on the desktop, each in a window of its own and themed along with the rest of it.</Description>
	  <PackageTags>umbraco;backoffice;desktop;accessories;notepad;paint;sticky-notes;calculator;clock;character-map;screensaver;disk-cleanup;system-information;umbradesktop;apps;umbraco-marketplace</PackageTags>
	  <RootNamespace>Umbraco.Community.UmbraDesktop.Accessories</RootNamespace>
	  <Authors>Luuk Peters</Authors>
	  <Company>Luuk Peters</Company>
	  <Copyright>Copyright (c) Luuk Peters</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/Luuk1983/Umbraco.Community.UmbraDesktop</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/Luuk1983/Umbraco.Community.UmbraDesktop</PackageProjectUrl>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <!-- Shares the host package's artwork rather than inventing a second logo: the two ship as one
	       release and read as one product on the Marketplace. Naming a file that does not exist
	       fails the pack, so this points at the host project's image and packs it by path below. -->
	  <PackageIcon>Package-image_128_128.png</PackageIcon>
	  <!-- Its own readme, not the host's: the root README.md is the desktop's page and would
	       describe a product this package is only an add-on to. Without this the pack warns
	       "missing a readme" and the nuget.org page shows nothing below the metadata. -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

	  <!-- Symbols + SourceLink: consumers can debug into the source at the exact built commit -->
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
  </PropertyGroup>

	<!-- The built umbraco-package.json, which SyncUmbracoPackageVersion (src/Directory.Build.targets)
	     stamps with this package's version. Versioning is shared by all six packages, there. -->
	<PropertyGroup>
		<UmbracoPackageJsonPath>$(ProjectDir)wwwroot\App_Plugins\Umbraco.Community.UmbraDesktop.Accessories\umbraco-package.json</UmbracoPackageJsonPath>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <WarningsNotAsErrors>NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only files. ContentTargetFolders is ".", so anything left as Content packs
         to the package root; without these the package ships package-lock.json and the
         TypeScript sources' config instead of just the built output. -->
    <Content Remove="backoffice\**" />
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
    <!-- The add-on's docs reach the package through the Vite build, which copies them into
         wwwroot for the desktop's Help app: without this, docs/product.json would also pack as
         content at the package root. -->
    <Content Remove="docs\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packs the host project's icon into this package's root, where PackageIcon expects it. -->
    <None Include="..\Umbraco.Community.UmbraDesktop\Package-image_128_128.png" Pack="true" PackagePath="\" />
    <!-- Update, not Include: the SDK's default None glob already matches this file, and including
         it a second time fails the pack with a duplicate-item error. -->
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup>
	  <PackageReference Include="MinVer" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <!-- The host, as the project built beside this one rather than a package from nuget.org. A
	       package range compiles against the lowest host in range, so this add-on would be built
	       against 17.0.0 and ship claiming to work with a host that lacks what it relies on: the
	       package catalogue that defines its launcher group, the unsaved-work attribute Notepad,
	       Paint and Sticky Notes set, and the settings context's formatDateTime the Clock uses.
	       Built from the same commit, the two cannot disagree.
	       It also brings Umbraco.Cms.Api.Management, the Sticky Notes controller's base class and
	       backoffice route, and Umbraco.Cms.Core transitively.
	       The packed range, "[<this release>, 17.99999999.0]", comes from the BoundHostRange target
	       in src/Directory.Build.targets, which every add-on referencing the host picks up. -->
	  <ProjectReference Include="..\Umbraco.Community.UmbraDesktop\Umbraco.Community.UmbraDesktop.csproj" />
	  <!-- The media service, which opens and saves Notepad's and Paint's files. A reference, not just
	       a runtime expectation, so installing Accessories installs it: its code is reached by a
	       context alias and never imported, so nothing else would bring it. Bounded like the host by
	       the same BoundHostRange target. -->
	  <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Services.Media\Umbraco.Community.UmbraDesktop.Services.Media.csproj" />
	</ItemGroup>

</Project>
