{
	"name": "umbradesktop-media",
	"private": true,
	"version": "17.0.0",
	"type": "module",
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"watch": "cd backoffice && tsc && vite build --watch",
		"build": "cd backoffice && tsc && vite build",
		"test": "cd backoffice && web-test-runner \"src/**/*.test.ts\" --node-resolve",
		"test:watch": "cd backoffice && web-test-runner \"src/**/*.test.ts\" --node-resolve --watch"
	},
	"dependencies": {
		"fabric": "7.4.0",
		"lit": "^3.3.1"
	},
	"devDependencies": {
		"@open-wc/testing": "^4.0.0",
		"@types/mocha": "^10.0.9",
		"@umbraco-cms/backoffice": "17.6.0",
		"@umbraco-ui/uui": "2.0.2",
		"@web/dev-server-esbuild": "^1.0.4",
		"@web/test-runner": "^0.20.0",
		"@web/test-runner-commands": "^0.9.0",
		"diff": "^9.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"ignoredBuiltDependencies": [
			"canvas"
		]
	},
	"-vs-binding": {
		"ProjectOpened": [
			"watch"
		]
	}
}
