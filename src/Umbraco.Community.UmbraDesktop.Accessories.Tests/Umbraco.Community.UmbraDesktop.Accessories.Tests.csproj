<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The global XML-doc rule applies to tests too, as it does in the host's test project. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The add-on alone. It reaches the host through its own package reference, so these tests run
         against the host as a consumer gets it rather than against the source beside it. -->
    <ProjectReference Include="..\Umbraco.Community.UmbraDesktop.Accessories\Umbraco.Community.UmbraDesktop.Accessories.csproj" />
  </ItemGroup>

</Project>
