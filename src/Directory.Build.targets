<Project>
	<!-- Every packed project gets its README's relative links and images pinned to the commit being
	     packed. NuGet resolves no relative links, and the Umbraco Marketplace shows the packed
	     README too, so the file in the repository (relative, right on GitHub) cannot be packed as
	     it is. Pinning to the commit rather than to main keeps an older version's package page on
	     that version's screenshots and docs. The rewrite is backoffice/scripts/docs/pin-readme.mjs,
	     which has the tests. Needs node on the packing machine, which the frontend build already
	     does. -->
	<Target Name="PinPackedReadme" BeforeTargets="_GetPackageFiles" Condition="'$(PackageReadmeFile)' != ''">
		<ItemGroup>
			<_ReadmeToPin Include="@(None)" Condition="'%(None.Pack)' == 'true' and '%(Filename)%(Extension)' == '$(PackageReadmeFile)'" />
		</ItemGroup>
		<PropertyGroup>
			<_ReadmeToPinPath>@(_ReadmeToPin->'%(FullPath)')</_ReadmeToPinPath>
			<_PinnedReadmePath>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)pinned-readme\$(PackageReadmeFile)</_PinnedReadmePath>
		</PropertyGroup>
		<Error Condition="'$(_ReadmeToPinPath)' == ''" Text="PinPackedReadme found no packed None item named $(PackageReadmeFile)." />
		<Exec Command="node &quot;$(MSBuildThisFileDirectory)Umbraco.Community.UmbraDesktop\backoffice\scripts\docs\pack-readme.mjs&quot; --readme &quot;$(_ReadmeToPinPath)&quot; --out &quot;$(_PinnedReadmePath)&quot; --repo-url &quot;$(RepositoryUrl)&quot; --ref &quot;$(SourceRevisionId)&quot;" />
		<ItemGroup>
			<None Remove="@(_ReadmeToPin)" />
			<None Include="$(_PinnedReadmePath)" Pack="true" PackagePath="\" />
		</ItemGroup>
	</Target>
</Project>
