{
	"name": "umbradesktop",
	"private": true,
	"version": "17.0.0",
	"type": "module",
	"scripts": {
		"wallpapers": "cd backoffice && node scripts/build-wallpapers.mjs",
		"watch": "cd backoffice && node scripts/build-wallpapers.mjs && tsc && vite build --watch",
		"build": "cd backoffice && node scripts/build-wallpapers.mjs && tsc && vite build",
		"generate-client": "node backoffice/scripts/generate-openapi.js https://localhost:44356/umbraco/swagger/management/swagger.json",
		"test": "cd backoffice && web-test-runner \"src/**/*.test.ts\" --node-resolve",
		"test:watch": "cd backoffice && web-test-runner \"src/**/*.test.ts\" --node-resolve --watch"
	},
	"dependencies": {
		"lit": "^3.2.1"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.85.2",
		"@open-wc/testing": "^4.0.0",
		"@types/mocha": "^10.0.9",
		"@umbraco-cms/backoffice": "^17",
		"@web/dev-server-esbuild": "^1.0.4",
		"@web/test-runner": "^0.20.0",
		"chalk": "^5.6.2",
		"cross-env": "^10.1.0",
		"eslint": "^9.18.0",
		"node-fetch": "^3.3.2",
		"sharp": "^0.35.4",
		"typescript": "^5.9.3",
		"vite": "^7.1.9"
	},
	"-vs-binding": {
		"ProjectOpened": [
			"watch"
		]
	}
}
