<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="Proud_Nerds_feed" value="https://pkgs.dev.azure.com/proudnerds/_packaging/Proudnerds_internal_libraries/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="Proud_Nerds_feed">
			<package pattern="ProudNerds.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
